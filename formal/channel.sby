[tasks]
prove
cover

[options]
# k-induction: an unbounded proof whose base case also covers bounded checking,
# so a separate BMC task would only repeat work.
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
smtbmc bitwuzla

[script]
read -formal -D FORMAL aimem_secded_64.sv aimem_t0_channel.sv aimem_t0_channel_sby.sv
prep -top aimem_t0_channel_sby

[files]
../rtl/aimem_secded_64.sv
../rtl/aimem_t0_channel.sv
aimem_t0_channel_sby.sv
